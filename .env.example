# Local SQLite file. Created by `npm run setup`.
DATABASE_URL="file:./dev.db"

# mock: deterministic team output, no network call.
# live: requires OPENAI_API_KEY (or LLM_API_KEY) and an OpenAI-compatible chat API.
LLM_MODE=mock
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# LLM_API_KEY=

# mock charges nothing and adds credits. stripe_fpx, billplz, and toyyibpay are named but not connected.
PAYMENT_PROVIDER=mock
# STRIPE_SECRET_KEY=
# BILLPLZ_API_KEY=
# TOYYIBPAY_SECRET_KEY=

# mock (default): every client connect is a simulated consent screen.
# live: a provider uses real OAuth only when its keys below are set.
INTEGRATIONS_MODE=mock
# 32 bytes, 64 hex chars or standard base64. Required for live tokens.
# INTEGRATIONS_ENCRYPTION_KEY=

# Google OAuth. One consent covers Drive (drive.file) and Sheets.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://web-production-ab130.up.railway.app/api/integrations/google/callback

# Adsmart platform keys. Clients never connect Buffer or Canva.
# BUFFER_API_KEY=
# CANVA_CLIENT_ID=
# CANVA_CLIENT_SECRET=

# Social OAuth. Unused while INTEGRATIONS_MODE=mock.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
